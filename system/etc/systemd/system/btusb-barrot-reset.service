[Unit]
# Recarrega o btusb depois que o USB assentou. A regra do udev sozinha pode
# nao bastar: o contorno roda no probe do modulo, que acontece junto com o
# add do udev — sem garantia de ordem. Recarregar depois refaz o contorno
# com o autosuspend ja configurado.
Description=Recarrega btusb para reaplicar o contorno do Barrot 8041a02
After=multi-user.target bluetooth.service
Wants=bluetooth.service

[Service]
Type=oneshot
ExecStartPre=/usr/bin/sleep 5
ExecStart=/usr/bin/modprobe -r btusb
ExecStart=/usr/bin/sleep 2
ExecStart=/usr/bin/modprobe btusb
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
