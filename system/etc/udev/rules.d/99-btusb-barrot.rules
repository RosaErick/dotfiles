# Dongle Bluetooth 0a12:0001 (chip Barrot 8041a02 que se identifica como CSR).
#
# O kernel detecta esse chip e tenta um contorno na inicializacao: forcar um
# suspend USB uma vez, o que reseta o estado do radio. Quando esse suspend
# falha, o log mostra:
#   CSR: Couldn't suspend the device for our Barrot 8041a02 receive-issue workaround
# e o resultado e um adaptador que conecta mas nao recebe dados.
#
# Zerar o atraso de autosuspend aumenta a chance do suspend completar.
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="0a12", ATTR{idProduct}=="0001", \
  ATTR{power/control}="auto", ATTR{power/autosuspend_delay_ms}="0"
