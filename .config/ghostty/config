# ~/.config/ghostty/config
# Recarregar sem reiniciar: ctrl+shift+,

# ── Fonte ─────────────────────────────────────────────────────────
# MesloLGS NF é a exigida pelo powerlevel10k (glifos do prompt).
font-family = MesloLGS NF
font-size = 12
adjust-cell-height = 12%

# ── Cores: Nightfox (tema embutido do Ghostty) ────────────────────
# background #161616 — cinza puro, o mais escuro da família.
# Variantes: nightfox (azul), terafox (verde), nordfox (claro), duskfox (roxo).
theme = current

# ── Transparencia e blur ──────────────────────────────────────────
# O blur em si e do compositor: o Hyprland desfoca o que esta ATRAS de
# qualquer superficie translucida. Por isso basta a opacidade < 1 aqui.
background-opacity = 0.9
background-blur = true

# ── Janela ────────────────────────────────────────────────────────
window-padding-x = 8
window-padding-y = 4
window-padding-balance = true
window-decoration = true
window-save-state = always
# "desktop" (padrão): single-instance só quando aberto pelo ícone do menu.
# Aberto via linha de comando, sobe processo novo e RELÊ a config do disco —
# é assim que dá pra testar mudança sem fechar as janelas existentes.
gtk-single-instance = desktop
gtk-tabs-location = top

# Split sem foco escurece — dá pra ver onde você está.
unfocused-split-opacity = 0.85

# ── Cursor ────────────────────────────────────────────────────────
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

# ── Shell integration ─────────────────────────────────────────────
# Sem "command": abre o shell de login (zsh). Rode `fish` quando quiser.
# Marca prompts (salto ctrl+shift+seta), herda o cwd em split/aba nova,
# muda o cursor no modo vi, destaca comando com sudo.
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# ── Scrollback e clipboard ────────────────────────────────────────
scrollback-limit = 100000000
copy-on-select = clipboard
# ask = pergunta antes de deixar um programa LER seu clipboard.
# Não mude pra "allow": qualquer script rodando no terminal passaria a ler senhas coladas.
clipboard-read = ask
clipboard-write = allow
clipboard-paste-protection = true
clipboard-trim-trailing-spaces = true

# ── Segurança / confirmação ───────────────────────────────────────
confirm-close-surface = true
quit-after-last-window-closed = true

# ── Keybinds ──────────────────────────────────────────────────────
# Splits (substitui tmux para dividir tela)
keybind = ctrl+shift+e=new_split:right
keybind = ctrl+shift+o=new_split:down
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:bottom
keybind = ctrl+shift+k=goto_split:top
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+z=toggle_split_zoom
keybind = ctrl+shift+x=close_surface

# Redimensionar split
keybind = ctrl+alt+shift+h=resize_split:left,10
keybind = ctrl+alt+shift+j=resize_split:down,10
keybind = ctrl+alt+shift+k=resize_split:up,10
keybind = ctrl+alt+shift+l=resize_split:right,10

# Fonte
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

# Limpar scrollback de verdade (não só a tela)
keybind = ctrl+shift+delete=clear_screen

# Recarregar config. ctrl+shift+comma é o padrão; ctrl+shift+r é alternativa
# caso o teclado/layout não entregue a vírgula com shift.
keybind = ctrl+shift+r=reload_config

# Saltar entre prompts (precisa da shell-integration acima)
keybind = ctrl+shift+up=jump_to_prompt:-1
keybind = ctrl+shift+down=jump_to_prompt:1
