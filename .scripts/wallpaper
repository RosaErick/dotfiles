#!/usr/bin/python3
"""Seletor de wallpaper (SUPER+W).

Fluxo: escolhe a imagem numa grade de miniaturas, depois o monitor, depois
o modo de ajuste. Aplica na hora e persiste no reboot.

Como persiste
-------------
O estado por monitor fica em ~/.config/hypr/wallpapers.json e o
hyprpaper.conf e GERADO a partir dele — igual ao monitors.lua do
nwg-displays. Por isso o .conf nao e versionado: e estado da maquina,
nao configuracao. O gerador (este script) e que esta no repo.

O symlink ~/.config/hypr/wallpaper aponta para a imagem do primeiro
monitor; o hyprlock usa ele, entao a tela de bloqueio acompanha.

    wallpaper                 seletor completo
    wallpaper <arquivo>       aplica em todos, modo atual
    wallpaper --random        sorteia
"""
import json
import random
import subprocess
import sys
import tomllib
from pathlib import Path

DIR = Path.home() / "Imagens/wallpapers"
HYPR = Path.home() / ".config/hypr"
ESTADO = HYPR / "wallpapers.json"
CONF = HYPR / "hyprpaper.conf"
LINK = HYPR / "wallpaper"
DOTS = Path.home() / ".dotfiles"
EXT = {".jpg", ".jpeg", ".png", ".webp", ".heic", ".bmp"}

# hyprpaper so conhece estes tres — 'stretch'/'fill' nao existem no binario
# e seriam ignorados em silencio.
MODOS = [("cover", "preencher a tela (corta as bordas)"),
         ("contain", "caber inteira (deixa barras)"),
         ("tile", "repetir lado a lado")]


def paleta():
    p = {"accent": "#78a9ff", "bg_raw": "22,22,22"}
    try:
        atual = (DOTS / "theme/.current").read_text().strip()
        with open(DOTS / f"theme/palettes/{atual}.toml", "rb") as f:
            c = tomllib.load(f).get("colors", {})
        if "accent" in c:
            p["accent"] = c["accent"]
        if "bg" in c:
            r, g, b = (int(c["bg"][i:i + 2], 16) for i in (1, 3, 5))
            p["bg_raw"] = f"{r},{g},{b}"
    except Exception:
        pass
    return p


def rofi(entradas, prompt, tema_extra="", icones=False):
    p = paleta()
    tema = (f"window {{ background-color: rgba({p['bg_raw']}, 1.0); }} "
            f"element selected {{ background-color: {p['accent']}; "
            f"                    text-color: rgba({p['bg_raw']}, 1.0); }} "
            + tema_extra)
    cmd = ["rofi", "-dmenu", "-i", "-p", prompt, "-theme-str", tema]
    if icones:
        cmd.insert(3, "-show-icons")
    r = subprocess.run(cmd, input="\n".join(entradas),
                       capture_output=True, text=True)
    return r.stdout.strip()


def monitores():
    r = subprocess.run(["hyprctl", "monitors", "-j"],
                       capture_output=True, text=True)
    try:
        return [m["name"] for m in json.loads(r.stdout)]
    except Exception:
        return []


def imagens():
    if not DIR.is_dir():
        sys.exit(f"nao achei {DIR}")
    return sorted((f for f in DIR.iterdir()
                   if f.is_file() and f.suffix.lower() in EXT),
                  key=lambda f: f.name.lower())


def ler_estado():
    try:
        return json.loads(ESTADO.read_text())
    except Exception:
        return {}


def gravar(estado):
    """Regenera o hyprpaper.conf inteiro a partir do estado e recarrega."""
    ESTADO.write_text(json.dumps(estado, indent=2, ensure_ascii=False))

    linhas = ["# GERADO por `wallpaper` — nao edite, sera sobrescrito.",
              "# Estado em ~/.config/hypr/wallpapers.json", ""]
    for mon, cfg in sorted(estado.items()):
        alvo = "" if mon == "*" else mon
        linhas += ["wallpaper {",
                   f"    monitor  = {alvo}",
                   f"    path     = {cfg['path']}",
                   f"    fit_mode = {cfg['fit']}",
                   "}", ""]
    linhas += ["splash = false", "ipc = on", ""]
    CONF.write_text("\n".join(linhas))

    # symlink para o hyprlock acompanhar (usa a imagem do primeiro monitor)
    primeiro = sorted(estado.values(), key=lambda c: c["path"])[0]["path"]
    if LINK.is_symlink() or LINK.exists():
        LINK.unlink()
    LINK.symlink_to(primeiro)

    r = subprocess.run(["systemctl", "--user", "restart", "hyprpaper.service"],
                       capture_output=True, text=True)
    return r.returncode == 0


def aplicar(img, alvos, fit):
    img = str(Path(img).resolve())
    estado = ler_estado()
    if alvos == ["*"]:
        estado = {"*": {"path": img, "fit": fit}}      # todos: um bloco so
    else:
        # Ao sair de "todos" para "por monitor", os demais precisam herdar o
        # wallpaper ANTERIOR — semear com o novo faria todos mudarem juntos.
        anterior = estado.pop("*", None)
        for m in monitores():
            if m not in estado:
                estado[m] = dict(anterior) if anterior else {"path": img, "fit": fit}
        for m in alvos:
            estado[m] = {"path": img, "fit": fit}
    ok = gravar(estado)
    onde = "todos os monitores" if alvos == ["*"] else ", ".join(alvos)
    subprocess.run(["notify-send", "-t", "2500", "Wallpaper",
                    f"{Path(img).name}\n{onde} — {fit}"], capture_output=True)
    print(("ok: " if ok else "falhou: ") + f"{Path(img).name} [{onde}, {fit}]")


def main():
    args = sys.argv[1:]
    if args and args[0] in ("-h", "--help"):
        print(__doc__)
        return
    imgs = imagens()
    if not imgs:
        sys.exit(f"nenhuma imagem em {DIR}")

    fit_atual = next(iter(ler_estado().values()), {}).get("fit", "cover")

    if args and args[0] == "--random":
        return aplicar(random.choice(imgs), ["*"], fit_atual)
    if args:
        alvo = Path(args[0])
        if not alvo.is_absolute():
            alvo = DIR / args[0]
        if not alvo.is_file():
            sys.exit(f"nao achei {alvo}")
        return aplicar(alvo, ["*"], fit_atual)

    # 1) imagem
    grade = ("listview { columns: 4; lines: 3; spacing: 10px; scrollbar: false; } "
             "element { orientation: vertical; padding: 8px; border-radius: 8px; "
             "          spacing: 6px; } "
             "element-icon { size: 190px; horizontal-align: 0.5; } "
             "element-text { horizontal-align: 0.5; } "
             "window { width: 76%; height: 74%; padding: 16px; }")
    escolha = rofi([f"{f.name}\0icon\x1f{f}" for f in imgs],
                   "wallpaper", grade, icones=True)
    img = next((f for f in imgs if f.name == escolha), None)
    if not img:
        return

    # 2) monitor
    mons = monitores()
    opts = ["󰍺  Todos os monitores"] + [f"󰍹  {m}" for m in mons]
    lista = ("window { width: 34%; } "
             f"listview {{ lines: {len(opts)}; }}")
    esc = rofi(opts, "onde", lista)
    if not esc:
        return
    alvos = ["*"] if "Todos" in esc else [esc.split()[-1]]

    # 3) ajuste
    opts_fit = [f"{n}   —   {d}" for n, d in MODOS]
    esc = rofi(opts_fit, "ajuste",
               "window { width: 42%; } listview { lines: 3; }")
    if not esc:
        return
    fit = esc.split()[0]

    aplicar(img, alvos, fit)


if __name__ == "__main__":
    main()
