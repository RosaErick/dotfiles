#!/bin/sh
# Instala os arquivos de sistema de system/etc/ (fora do stow: exigem root).
# Idempotente. Para reverter, remova os arquivos listados no fim.
set -e
ORIGEM="$HOME/.dotfiles/system"

sudo install -Dm644 "$ORIGEM/etc/udev/rules.d/99-btusb-barrot.rules" \
                    /etc/udev/rules.d/99-btusb-barrot.rules
sudo install -Dm644 "$ORIGEM/etc/systemd/system/btusb-barrot-reset.service" \
                    /etc/systemd/system/btusb-barrot-reset.service

sudo udevadm control --reload-rules
sudo systemctl daemon-reload
sudo systemctl enable btusb-barrot-reset.service

echo
echo "instalado:"
echo "  /etc/udev/rules.d/99-btusb-barrot.rules"
echo "  /etc/systemd/system/btusb-barrot-reset.service  (habilitado)"
echo
echo "para aplicar agora, sem reiniciar:"
echo "  sudo systemctl start btusb-barrot-reset"
echo
echo "para conferir se o contorno passou:"
echo "  journalctl -k -b | grep -c \"Couldn't suspend the device\"    # 0 = ok"
