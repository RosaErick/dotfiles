{
    // GERADO por `theme` — edite theme/templates/waybar-config.jsonc.tmpl
    // Os icones levam cor via markup Pango (cores da paleta); os valores
    // ficam neutros. Cor identifica o modulo, o numero continua legivel.
    // Barra propria: mistura o minimalismo flutuante do space_dots (vdawg-git)
    // com o efeito 3D de tecla do summer-day-and-night (MathisP75),
    // na paleta do nosso tema. O visual mora em theme/templates/waybar-style.css.tmpl
    "layer": "top",
    "position": "top",
    "height": 42,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 8,

    "modules-left":   ["custom/launcher", "hyprland/workspaces", "hyprland/submap"],
    "modules-center": ["hyprland/window"],
    "modules-right":  ["cpu", "memory", "group/audio", "network",
                       "hyprland/language", "clock", "tray", "custom/power"],

    // --- esquerda ---------------------------------------------------------
    "custom/launcher": {
        "format": "󰝴",
        "on-click": "rofi -show drun -theme grid",
        "tooltip-format": "aplicativos  (SUPER+D)"
    },

    // numerais CJK, ideia do space_dots: ocupam 1 caractere e nao viram ruido
    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "sort-by-number": true,
        "format-icons": {
            "1": "一", "2": "二", "3": "三", "4": "四", "5": "五",
            "6": "六", "7": "七", "8": "八", "9": "九", "10": "十"
        }
    },

    // --- centro -----------------------------------------------------------
    "hyprland/window": {
        "max-length": 55,
        "separate-outputs": true,
        "format": "{}",
        "rewrite": {
            "": "—"
        }
    },

    // --- direita ----------------------------------------------------------
    // Os blocos ▁▂▃ do space_dots sao ancorados na base da celula e nao
    // compartilham a linha de base dos digitos — ficavam desalinhados e
    // ocupavam largura demais. Numero puro alinha e cabe.
    "cpu": {
        "states": { "warning": 75, "critical": 92 },
        "interval": 3,
        "format": "<span color='{{cyan}}'>󰻠</span> {usage}%",
        "tooltip-format": "CPU {usage}%   —   clique abre o monitor",
        "on-click": "taskmanager"
    },
    "memory": {
        "states": { "warning": 80, "critical": 93 },
        "interval": 10,
        "format": "<span color='{{cyan}}'>󰍛</span> {percentage}%  {used:0.1f}/{total:0.0f}G",
        "tooltip-format": "RAM {used:0.1f}G / {total:0.1f}G  ({percentage}%)",
        "on-click": "taskmanager"
    },
    // Passar o mouse revela slider + trocar saida/entrada.
    // "drawer" e nativo do waybar: esconde tudo menos o primeiro filho.
    "group/audio": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 250,
            "children-class": "audio-item",
            "transition-left-to-right": false
        },
        "modules": ["pulseaudio", "pulseaudio/slider",
                    "custom/audio-out", "custom/audio-in"]
    },
    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },
    "custom/audio-out": {
        "format": "󰓃",
        "on-click": "audio-device out",
        "tooltip-format": "trocar saida de audio"
    },
    "custom/audio-in": {
        "format": "󰍬",
        "on-click": "audio-device in",
        "tooltip-format": "trocar entrada (microfone)"
    },

    "pulseaudio": {
        "format": "<span color='{{magenta}}'>{icon}</span> {volume}%",
        "format-muted": "<span color='{{fg_mute}}'>󰝟</span> mudo",
        "format-icons": { "headphone": "󰋋", "headset": "󰋎", "default": ["󰕿", "󰖀", "󰕾"] },
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },
    "network": {
        "format-ethernet": "<span color='{{green}}'>󰈀</span>",
        "format-wifi": "<span color='{{green}}'>󰖩</span> {signalStrength}%",
        "format-disconnected": "<span color='{{red}}'>󰖪</span>",
        "tooltip-format-ethernet": "{ifname}   {ipaddr}",
        "tooltip-format-wifi": "{essid}   {ipaddr}   {signalStrength}%",
        "tooltip-format-disconnected": "sem rede",
        "on-click": "nm-connection-editor"
    },
    "hyprland/language": {
        "format": "<span color='{{yellow}}'>󰌌</span> {}",
        "format-en": "US",
        "format-pt": "BR",
        "on-click": "hyprctl switchxkblayout current next",
        "tooltip-format": "layout do teclado  (SUPER+ESPACO)"
    },
    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%a %d/%m}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },
    "tray": { "icon-size": 15, "spacing": 8 },
    "custom/power": {
        "format": "󰐥",
        "on-click": "powermenu",
        "tooltip-format": "sessao  (CTRL+ALT+DEL)"
    }
}
