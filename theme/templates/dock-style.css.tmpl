/* GERADO por `theme` — edite theme/templates/dock-style.css.tmpl */
/* Mesma receita de vidro da waybar e do rofi. O blur vem da layer_rule
   "blur-dock" no hyprland.lua — sem ela o fundo apareceria nitido. */
window {
    background: rgba({{bg_raw}}, {{alpha_rofi}});
    border-radius: 14px;
    border: 1px solid rgba({{line_raw}}, 0.6);
}
#box { padding: 8px; }
#active { border-bottom: solid 2px; border-color: {{accent}}; }
button, image { background: none; border: none; box-shadow: none; color: {{fg_dim}}; }
button {
    padding: 6px;
    margin: 0 3px;
    color: {{fg}};
    border-radius: 6px;
}
button:hover { background-color: {{bg_high}}; }
button:focus { box-shadow: none; }
