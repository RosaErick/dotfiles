/* GERADO por `theme` a partir de theme/templates/waybar-style.css.tmpl
   NAO EDITE ESTE ARQUIVO — edite o template. */
* {
    font-family: "{{font}}", monospace;
    font-size: {{font_size}};
    border: none;
    border-radius: 0;
    min-height: 0;
}
window#waybar { background: rgba({{bg_raw}}, {{alpha}}); color: {{fg}}; }
#workspaces button { padding: 0 8px; color: {{fg_mute}}; }
#workspaces button.active { color: {{fg}}; box-shadow: inset 0 -2px {{accent}}; }
#workspaces button:hover { background: {{bg_high}}; }
#window { color: {{fg_dim}}; }
#pulseaudio, #network, #cpu, #memory, #clock, #tray { padding: 0 10px; }
#clock { color: {{accent}}; font-weight: bold; }
#network.disconnected { color: {{urgent}}; }
