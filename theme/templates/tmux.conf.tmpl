# GERADO por `theme` — edite theme/templates/tmux.conf.tmpl

# Ghostty e kitty fazem truecolor; sem os overrides o tmux degrada para 256
# cores e o tema do Neovim fica lavado dentro da sessao.
set -g default-terminal "tmux-256color"
set -ga terminal-overrides ",xterm-ghostty:Tc,xterm-kitty:Tc"

set -g mouse on
set -g history-limit 100000
setw -g mode-keys vi

# Janelas comecam em 1: o 0 fica longe demais na fileira de numeros.
set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on

# Sem isto o <Esc> do Neovim tem lag perceptivel dentro do tmux.
set -sg escape-time 10

# ── Panes ─────────────────────────────────────────────────────────
# Estes binds vieram do Ghostty, que antes dividia a tela. La foram
# removidos para nao competir com os panes; aqui usam o prefixo (C-b).
# Splits herdam o diretorio atual, que nao e o padrao do tmux.
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"

bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R

# -r deixa repetir sem reapertar o prefixo a cada ajuste.
bind -r H resize-pane -L 10
bind -r J resize-pane -D 10
bind -r K resize-pane -U 10
bind -r L resize-pane -R 10
# zoom (C-b z) ja e padrao do tmux, nao precisa bind.

# ── Cores: vem da paleta ativa ────────────────────────────────────
set -g status-style "bg={{bg_alt}},fg={{fg_dim}}"
set -g status-left "#[bg={{accent}},fg={{bg}},bold] #S #[default] "
set -g status-right "#[fg={{fg_mute}}]%H:%M "
set -g status-left-length 30

setw -g window-status-current-style "bg={{bg_high}},fg={{accent}},bold"
setw -g window-status-style "fg={{fg_mute}}"

# A borda ativa usa o mesmo amarelo da borda de janela do Hyprland, entao
# pane e janela falam a mesma linguagem visual.
set -g pane-border-style "fg={{line}}"
set -g pane-active-border-style "fg={{yellow}}"

set -g message-style "bg={{bg_high}},fg={{fg}}"
set -g mode-style "bg={{sel}},fg={{fg}}"
