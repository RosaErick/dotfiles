# GERADO por `theme` — edite theme/templates/mako-config.tmpl
font={{font}} 10
background-color={{bg}}{{alpha_hex}}
text-color={{fg}}
border-color={{accent}}
progress-color=over {{bg_high}}
border-size=2
border-radius=6
padding=12
margin=10
default-timeout=6000
anchor=top-right
max-visible=5

[urgency=critical]
border-color={{urgent}}
default-timeout=0
