/* GERADO por `theme` — edite theme/templates/rofi-grid.rasi.tmpl
   Grade de aplicativos: SUPER+D. Tema autocontido (-theme substitui tudo). */
* {
    bg:     {{bg}};
    bg-alt: {{bg_alt}};
    fg:     {{fg}};
    fg-dim: {{fg_dim}};
    accent: {{accent}};
    line:   {{line}};

    background-color: transparent;
    text-color:       @fg;
    font: "{{font}}, {{font_alt}} 11";
}

window {
    background-color: rgba({{bg_raw}}, {{alpha_rofi}});
    border:           1px;
    border-color:     @line;
    border-radius:    {{radius}};
    width:            70%;
    height:           68%;
    padding:          24px;
    children:         [ mainbox ];
}

mainbox {
    children: [ inputbar, listview ];
    spacing:  20px;
}

inputbar {
    children:      [ prompt, entry ];
    spacing:       12px;
    padding:       12px 16px;
    border-radius: 8px;
    background-color: @bg-alt;
}

prompt { text-color: @accent; vertical-align: 0.5; }
entry  {
    placeholder:       "buscar aplicativo";
    placeholder-color: @fg-dim;
    cursor:            text;
    vertical-align:    0.5;
}

listview {
    columns:      6;
    lines:        4;
    spacing:      12px;
    scrollbar:    false;
    fixed-height: true;
    flow:         horizontal;
}

element {
    orientation:   vertical;
    padding:       16px 8px;
    spacing:       10px;
    border-radius: 10px;
    children:      [ element-icon, element-text ];
}

element-icon {
    size:         56px;
    horizontal-align: 0.5;
}

element-text {
    horizontal-align: 0.5;
    vertical-align:   0.5;
}

element selected {
    background-color: @accent;
    text-color:       @bg;
}

element normal.active,
element alternate.active {
    background-color: @bg-alt;
}
