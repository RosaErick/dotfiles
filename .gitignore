packages/desktops/hyprland/compositor/.config/hypr/workspaces.lua
themes/.current

# fish: gerado pelo fisher e pelo proprio shell
packages/common/fish/.config/fish/functions/
packages/common/fish/.config/fish/completions/
packages/common/fish/.config/fish/conf.d/*
# ...menos o tide.fish, que preserva o layout e as cores do prompt.
